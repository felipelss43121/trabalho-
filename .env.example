# =============================================================================
# Configurações do Sistema e-Fisco Coletor
# Copie este arquivo para .env e preencha com seus valores reais
# =============================================================================

# --- Banco de Dados PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=efisco_analitico
DB_USER=efisco_user
DB_PASSWORD=sua_senha_aqui

# --- Credenciais Gov.br ---
GOVBR_CPF=00000000000
GOVBR_SENHA=sua_senha_govbr

# --- Parâmetros de Coleta – Despesa Empenhada ---
# Código da Unidade Gestora
UNIDADE_GESTORA=050501

# Pares Ação:Subação separados por vírgula
# Exemplo: 1313:2115,4685:1958,4685:1959,4685:1960,3929:0000
ACOES_SUBACOES=1313:2115,4685:1958,4685:1959,4685:1960,3929:0000

# --- Parâmetros de Coleta – Ficha Financeira ---
# Termos de busca no Detalhamento da Despesa Gerencial (separados por vírgula)
# Use TODOS para coletar todas as opções do select
DETALHAMENTOS_GERENCIAIS=subsidios,credito de vale transporte,Prog. Parcerias Público Privadas,TODOS

# --- Configurações do Playwright ---
HEADLESS=true
TIMEOUT_PADRAO=30000
TIMEOUT_NAVEGACAO=60000
SLOW_MO=0
# Caminho ao binário Chromium (deixe em branco para usar o Playwright padrão)
PLAYWRIGHT_CHROME_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# --- Retry ---
MAX_TENTATIVAS=3
ESPERA_ENTRE_TENTATIVAS=5

# --- Exportação ---
DIRETORIO_EXPORTS=exports
GERAR_CSV=true
GERAR_EXCEL=true

# --- Logs ---
LOG_LEVEL=INFO
LOG_DIR=logs
SCREENSHOT_DIR=screenshots
